
<!DOCTYPE html><html lang=\"es\" class=\"scroll-smooth bg-[#050505] text-zinc-100\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>LaunchGuard — Premium Launch Protection</title>\n    \n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    \n    <!-- Google Fonts: Inter -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n    <!-- Spline 3D Viewer -->\n    <script type=\"module\" src=\"https://unpkg.com/@splinetool/viewer@1.0.51/build/spline-viewer.js\"></script>\n\n    <!-- Lucide Icons -->\n    <script src=\"https://unpkg.com/lucide@latest\"></script>\n\n    <!-- Configuración personalizada de Tailwind -->\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    fontFamily: {\n                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', '\"Segoe UI\"', 'Roboto', 'sans-serif'],\n                    },\n                    colors: {\n                        zinc: {\n                            950: '#0a0a0b',\n                            900: '#18181b',\n                            800: '#27272a',\n                            700: '#3f3f46',\n                            600: '#52525b',\n                            500: '#71717a',\n                            400: '#a1a1aa',\n                            300: '#d4d4d8',\n                            200: '#e4e4e7',\n                            100: '#f4f4f5',\n                            50: '#fafafa',\n                        }\n                    },\n                    boxShadow: {\n                        'premium': '0 25px 50px -12px rgba(0, 0, 0, 0.8)',\n                        'glow': '0 0 40px -10px rgba(255, 255, 255, 0.1)',\n                        'neon-subtle': '0 0 30px -5px rgba(16, 185, 129, 0.15)',\n                    }\n                }\n            }\n        }\n    </script>\n\n    <style>\n        /* Reset y optimizaciones de renderizado */\n        html {\n            scroll-behavior: initial !important; /* Lenis toma el control */\n        }\n        body {\n            background-color: #050505;\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n            overflow-x: hidden;\n        }\n\n        /* Textura de Ruido Analógico Premium */\n        .noise-overlay {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100vw;\n            height: 100vh;\n            pointer-events: none;\n            z-index: 9999;\n            opacity: 0.035;\n            background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n        }\n\n        /* Glassmorphism Premium */\n        .glass-panel {\n            background: rgba(24, 24, 27, 0.3);\n            backdrop-filter: blur(24px);\n            -webkit-backdrop-filter: blur(24px);\n            border: 1px solid rgba(255, 255, 255, 0.05);\n        }\n\n        .glass-card {\n            background: linear-gradient(145deg, rgba(39, 39, 42, 0.2) 0%, rgba(24, 24, 27, 0.4) 100%);\n            backdrop-filter: blur(16px);\n            -webkit-backdrop-filter: blur(16px);\n            border: 1px solid rgba(255, 255, 255, 0.04);\n            transform-style: preserve-3d;\n        }\n\n        /* Animaciones de Revelado (Intersection Observer) */\n        .reveal {\n            opacity: 0;\n            transform: translateY(40px);\n            transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);\n            will-change: transform, opacity;\n        }\n        .reveal.active {\n            opacity: 1;\n            transform: translateY(0);\n        }\n\n        /* Utilidades tipográficas */\n        .text-balance {\n            text-wrap: balance;\n        }\n        \n        /* Ocultar logo de Spline si es posible mediante CSS */\n        spline-viewer::part(logo) {\n            display: none !important;\n        }\n    </style>\n</head>\n<body class=\"min-h-screen flex flex-col selection:bg-zinc-800 selection:text-zinc-100\">\n\n    <!-- Capa de Ruido -->\n    <div class=\"noise-overlay\"></div>\n\n    <!-- Navegación Sticky -->\n    <nav class=\"fixed w-full z-50 top-0 transition-all duration-300 glass-panel border-b-0 border-white/[0.02]\">\n        <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\">\n            <!-- Logo -->\n            <div class=\"flex items-center gap-3 cursor-pointer\" onclick=\"window.scrollTo(0,0)\">\n                <div class=\"w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center\">\n                    <i data-lucide=\"shield-check\" class=\"w-4 h-4 text-zinc-300\"></i>\n                </div>\n                <span class=\"font-medium text-sm tracking-widest uppercase text-zinc-200\">LaunchGuard</span>\n            </div>\n\n            <!-- Enlaces Desktop -->\n            <div class=\"hidden md:flex items-center gap-8\">\n                <a href=\"#metodo\" class=\"text-xs uppercase tracking-[0.15em] text-zinc-500 hover:text-zinc-200 transition-colors\">Método</a>\n                <a href=\"#casos\" class=\"text-xs uppercase tracking-[0.15em] text-zinc-500 hover:text-zinc-200 transition-colors\">Casos</a>\n                <a href=\"#desglose\" class=\"text-xs uppercase tracking-[0.15em] text-zinc-500 hover:text-zinc-200 transition-colors\">Desglose</a>\n            </div>\n\n            <!-- Badge Animado -->\n            <a href=\"#cta\" class=\"flex items-center gap-2 bg-white/[0.03] hover:bg-white/[0.08] transition-colors border border-white/[0.08] rounded-full px-4 py-2\">\n                <span class=\"relative flex h-2 w-2\">\n                  <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n                  <span class=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-500\"></span>\n                </span>\n                <span class=\"text-[10px] md:text-xs font-semibold uppercase tracking-widest text-zinc-300\">2 Cupos Disponibles</span>\n            </a>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <header class=\"relative min-h-screen flex items-center pt-20 overflow-hidden\">\n        <!-- Spline 3D Background -->\n        <div class=\"absolute inset-0 z-0 flex justify-end items-center opacity-40 md:opacity-100 pointer-events-auto\">\n            <div class=\"w-full h-full md:w-[60%] md:h-[120%] translate-x-10 md:translate-x-20\">\n                <spline-viewer url=\"https://prod.spline.design/qJ8O2R7Kk9X6M5p4/scene.splinecode\"></spline-viewer>\n            </div>\n        </div>\n\n        <!-- Gradiente para oscurecer el fondo detrás del texto en móvil -->\n        <div class=\"absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/80 to-transparent z-0 pointer-events-none\"></div>\n\n        <div class=\"max-w-7xl mx-auto px-6 relative z-10 w-full\">\n            <div class=\"max-w-3xl reveal\">\n                \n                <!-- BLOQUE EXACTO SOLICITADO -->\n                <div class=\"banner-container bg-[#050505] flex items-center gap-6 z-10 mb-10 p-4 rounded-2xl border border-white/[0.05] inline-flex shadow-premium\">\n                    <div class=\"w-16 h-16 rounded-xl bg-gradient-to-br from-zinc-800 to-black border border-zinc-800 flex items-center justify-center shadow-2xl\">\n                        <svg class=\"w-8 h-8 text-zinc-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z\"></path>\n                        </svg>\n                    </div>\n                    <div class=\"text-left pr-4\">\n                        <h1 class=\"text-5xl font-medium text-zinc-200 tracking-tight\">LaunchGuard<span class=\"text-zinc-600\">.</span></h1>\n                    </div>\n                </div>\n                <!-- FIN BLOQUE EXACTO -->\n\n                <h2 class=\"text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-medium tracking-tighter text-zinc-100 leading-[1.05] mb-8 text-balance\">\n                    No testeo tu juego.<br>\n                    <span class=\"text-zinc-600\">Blindo tu lanzamiento.</span>\n                </h2>\n                \n                <p class=\"text-lg md:text-xl text-zinc-400 font-light leading-relaxed mb-12 max-w-xl\">\n                    Auditoría premium B2B para estudios Indie y AA. Detectamos fricción crítica y bugs invisibles antes de que destruyan tus reseñas en Steam.\n                </p>\n\n                <div class=\"flex flex-col sm:flex-row items-center gap-5\">\n                    <a href=\"#cta\" class=\"w-full sm:w-auto px-8 py-4 rounded-xl bg-zinc-100 text-[#050505] hover:bg-white active:scale-[0.98] transition-all text-sm font-semibold tracking-widest uppercase text-center shadow-glow\">\n                        Agendar Auditoría\n                    </a>\n                    <a href=\"#metodo\" class=\"w-full sm:w-auto px-8 py-4 rounded-xl glass-panel text-zinc-300 hover:text-white hover:bg-white/[0.05] active:scale-[0.98] transition-all text-sm font-semibold tracking-widest uppercase text-center\">\n                        Ver Método\n                    </a>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Social Proof / Logos -->\n    <section class=\"py-12 border-y border-white/[0.02] bg-zinc-950/50 relative z-10\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <p class=\"text-center text-[10px] uppercase tracking-[0.3em] text-zinc-600 font-semibold mb-8 reveal\">Sistemas auditados para</p>\n            <div class=\"flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-40 grayscale reveal\" style=\"transition-delay: 100ms;\">\n                <div class=\"flex items-center gap-3 font-bold text-xl tracking-widest text-zinc-300\">\n                    <i data-lucide=\"triangle\" class=\"w-6 h-6 fill-current\"></i> KRONOS\n                </div>\n                <div class=\"flex items-center gap-3 font-bold text-xl tracking-widest text-zinc-300\">\n                    <i data-lucide=\"hexagon\" class=\"w-6 h-6 fill-current\"></i> ABK-GAMES\n                </div>\n                <div class=\"flex items-center gap-3 font-bold text-xl tracking-widest text-zinc-300\">\n                    <i data-lucide=\"circle-dashed\" class=\"w-6 h-6\"></i> CRIPTOGAMERS\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- El Dolor (Vender el Miedo) -->\n    <section class=\"py-32 md:py-48 relative z-10\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"max-w-5xl\">\n                <span class=\"text-xs uppercase tracking-[0.2em] text-zinc-600 font-semibold block mb-8 reveal\">La cruda realidad del mercado</span>\n                <h2 class=\"text-4xl sm:text-6xl md:text-7xl lg:text-[5.5rem] font-medium text-zinc-100 tracking-tighter leading-[1.1] mb-12 text-balance reveal\">\n                    A Steam no le importa cuántos años trabajaste.\n                </h2>\n                <div class=\"pl-0 md:pl-10 border-l-0 md:border-l-2 border-zinc-800 reveal\">\n                    <p class=\"text-2xl md:text-4xl text-zinc-400 font-light leading-tight text-balance\">\n                        <span class=\"text-zinc-200 font-medium\">10 minutos de fricción</span> el Día 1 equivalen a reseñas negativas, reembolsos masivos y la muerte algorítmica de tu lanzamiento.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Quién Soy (Autoridad) -->\n    <section class=\"py-24 md:py-32 bg-zinc-950/30 border-y border-white/[0.02] relative z-10\">\n        <div class=\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row gap-16 items-start\">\n            <div class=\"md:w-1/3 reveal\">\n                <div class=\"w-20 h-20 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center mb-6\">\n                    <i data-lucide=\"terminal\" class=\"w-8 h-8 text-zinc-400\"></i>\n                </div>\n                <h3 class=\"text-2xl font-medium tracking-tight text-zinc-200 mb-2\">Ezequiel Canello</h3>\n                <p class=\"text-sm uppercase tracking-widest text-zinc-500 font-semibold\">Game QA System Engineer</p>\n            </div>\n            <div class=\"md:w-2/3 reveal\" style=\"transition-delay: 150ms;\">\n                <p class=\"text-xl md:text-2xl text-zinc-400 font-light leading-relaxed mb-8\">\n                    Mi objetivo no es pasarte un Excel infinito con 500 bugs menores que a nadie le importan. Mi objetivo es <span class=\"text-zinc-200 font-medium\">proteger la rentabilidad de tu estudio.</span>\n                </p>\n                <p class=\"text-lg text-zinc-500 font-light leading-relaxed\">\n                    He visto años de desarrollo evaporarse en 48 horas por un \"game feel\" tosco en el tutorial o un soft-lock invisible. Actúo como el último filtro de calidad implacable antes de que te enfrentes al jugador real.\n                </p>\n            </div>\n        </div>\n    </section>\n\n    <!-- El Sistema LaunchGuard -->\n    <section id=\"metodo\" class=\"py-32 md:py-48 relative z-10\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"mb-20 reveal\">\n                <span class=\"text-xs uppercase tracking-[0.2em] text-zinc-600 font-semibold block mb-4\">Arquitectura de Servicio</span>\n                <h2 class=\"text-4xl md:text-5xl font-medium text-zinc-100 tracking-tight\">El Sistema LaunchGuard</h2>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                <!-- Columna 1 -->\n                <div class=\"glass-card p-10 rounded-3xl reveal\" data-tilt data-tilt-max=\"5\" data-tilt-speed=\"400\" data-tilt-glare=\"true\" data-tilt-max-glare=\"0.05\">\n                    <div class=\"w-14 h-14 rounded-xl bg-zinc-900/50 border border-zinc-800 flex items-center justify-center mb-8\" style=\"transform: translateZ(30px);\">\n                        <i data-lucide=\"crosshair\" class=\"w-6 h-6 text-zinc-300\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-medium text-zinc-200 tracking-tight mb-4\" style=\"transform: translateZ(20px);\">Auditoría Crítica</h3>\n                    <p class=\"text-zinc-400 font-light leading-relaxed text-sm\" style=\"transform: translateZ(10px);\">\n                        Análisis agresivo de los primeros 120 minutos de gameplay. Detecto y elimino cualquier aspereza en la UX que cause frustración temprana, asegurando la retención del Día 1.\n                    </p>\n                </div>\n\n                <!-- Columna 2 -->\n                <div class=\"glass-card p-10 rounded-3xl reveal\" style=\"transition-delay: 100ms;\" data-tilt data-tilt-max=\"5\" data-tilt-speed=\"400\" data-tilt-glare=\"true\" data-tilt-max-glare=\"0.05\">\n                    <div class=\"w-14 h-14 rounded-xl bg-zinc-900/50 border border-zinc-800 flex items-center justify-center mb-8\" style=\"transform: translateZ(30px);\">\n                        <i data-lucide=\"bot\" class=\"w-6 h-6 text-zinc-300\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-medium text-zinc-200 tracking-tight mb-4\" style=\"transform: translateZ(20px);\">QA Técnico con IA</h3>\n                    <p class=\"text-zinc-400 font-light leading-relaxed text-sm\" style=\"transform: translateZ(10px);\">\n                        Utilizo procesos automatizados y scripts de IA para estresar los sistemas y encontrar \"game-breakers\". Te entrego reportes quirúrgicos, directos y listos para accionar.\n                    </p>\n                </div>\n\n                <!-- Columna 3 -->\n                <div class=\"glass-card p-10 rounded-3xl reveal\" style=\"transition-delay: 200ms;\" data-tilt data-tilt-max=\"5\" data-tilt-speed=\"400\" data-tilt-glare=\"true\" data-tilt-max-glare=\"0.05\">\n                    <div class=\"w-14 h-14 rounded-xl bg-zinc-900/50 border border-zinc-800 flex items-center justify-center mb-8\" style=\"transform: translateZ(30px);\">\n                        <i data-lucide=\"shield\" class=\"w-6 h-6 text-zinc-300\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-medium text-zinc-200 tracking-tight mb-4\" style=\"transform: translateZ(20px);\">Blindaje de Reseñas</h3>\n                    <p class=\"text-zinc-400 font-light leading-relaxed text-sm\" style=\"transform: translateZ(10px);\">\n                        Filtro y optimizo el \"Game Feel\" basado en estándares AAA. Transformamos potenciales detractores en fans que recomiendan tu juego y defienden tu producto.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Casos de Éxito (Tarjetas 3D) -->\n    <section id=\"casos\" class=\"py-32 border-y border-white/[0.02] bg-zinc-950/20 relative z-10\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"mb-20 reveal\">\n                <span class=\"text-xs uppercase tracking-[0.2em] text-zinc-600 font-semibold block mb-4\">Prueba Social</span>\n                <h2 class=\"text-4xl md:text-5xl font-medium text-zinc-100 tracking-tight\">Estudios Blindados</h2>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n                <!-- Caso 1: Victor -->\n                <a href=\"https://ascender.uno/LaunchGuard/victor\" target=\"_blank\" rel=\"noopener noreferrer\" \n                   class=\"group block glass-card p-12 rounded-[2rem] border border-white/[0.05] hover:border-zinc-600/50 transition-colors duration-500 reveal\"\n                   data-tilt data-tilt-max=\"3\" data-tilt-speed=\"400\" data-tilt-glare=\"true\" data-tilt-max-glare=\"0.1\">\n                    <div class=\"flex justify-between items-start mb-16\" style=\"transform: translateZ(40px);\">\n                        <div class=\"w-12 h-12 rounded-full bg-zinc-800 flex items-center justify-center\">\n                            <i data-lucide=\"swords\" class=\"w-5 h-5 text-zinc-300\"></i>\n                        </div>\n                        <span class=\"text-xs font-semibold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-300 transition-colors flex items-center gap-2\">\n                            Ver Caso <i data-lucide=\"arrow-up-right\" class=\"w-4 h-4\"></i>\n                        </span>\n                    </div>\n                    <div style=\"transform: translateZ(20px);\">\n                        <h3 class=\"text-3xl font-medium text-zinc-100 tracking-tight mb-4\">Caso: Victor</h3>\n                        <p class=\"text-zinc-400 font-light leading-relaxed\">\n                            Intervención en fase final de pre-lanzamiento. Identificamos y eliminamos una crisis crítica de UX en la progresión inicial antes de que afectara la percepción pública.\n                        </p>\n                    </div>\n                </a>\n\n                <!-- Caso 2: Possible One / Upstairs -->\n                <a href=\"https://ascender.uno/LaunchGuard/upstairs\" target=\"_blank\" rel=\"noopener noreferrer\" \n                   class=\"group block glass-card p-12 rounded-[2rem] border border-white/[0.05] hover:border-zinc-600/50 transition-colors duration-500 reveal\" style=\"transition-delay: 150ms;\"\n                   data-tilt data-tilt-max=\"3\" data-tilt-speed=\"400\" data-tilt-glare=\"true\" data-tilt-max-glare=\"0.1\">\n                    <div class=\"flex justify-between items-start mb-16\" style=\"transform: translateZ(40px);\">\n                        <div class=\"w-12 h-12 rounded-full bg-zinc-800 flex items-center justify-center\">\n                            <i data-lucide=\"box\" class=\"w-5 h-5 text-zinc-300\"></i>\n                        </div>\n                        <span class=\"text-xs font-semibold uppercase tracking-widest text-zinc-500 group-hover:text-zinc-300 transition-colors flex items-center gap-2\">\n                            Ver Caso <i data-lucide=\"arrow-up-right\" class=\"w-4 h-4\"></i>\n                        </span>\n                    </div>\n                    <div style=\"transform: translateZ(20px);\">\n                        <h3 class=\"text-3xl font-medium text-zinc-100 tracking-tight mb-4\">Possible One / Upstairs</h3>\n                        <p class=\"text-zinc-400 font-light leading-relaxed\">\n                            Auditoría de UX en etapas tempranas. Rediseño del onboarding táctico y balance de dificultad que incrementó drásticamente la tasa de retención del primer día.\n                        </p>\n                    </div>\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Garantía de Riesgo Cero -->\n    <section class=\"py-32 relative z-10\">\n        <div class=\"max-w-5xl mx-auto px-6 reveal\">\n            <div class=\"relative rounded-[2.5rem] p-[1px] bg-gradient-to-b from-emerald-500/20 to-transparent shadow-neon-subtle overflow-hidden\">\n                <div class=\"bg-[#0a0a0b] rounded-[2.5rem] p-12 md:p-20 text-center relative\">\n                    <!-- Glow interior -->\n                    <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-md h-32 bg-emerald-500/10 blur-[60px] pointer-events-none\"></div>\n                    \n                    <div class=\"w-16 h-16 mx-auto rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-8\">\n                        <i data-lucide=\"badge-check\" class=\"w-8 h-8 text-emerald-400\"></i>\n                    </div>\n                    <h2 class=\"text-3xl md:text-5xl font-medium text-zinc-100 tracking-tight mb-6\">\n                        Garantía de Riesgo Cero\n                    </h2>\n                    <p class=\"text-lg md:text-2xl text-zinc-400 font-light leading-relaxed max-w-3xl mx-auto\">\n                        Si en la primera semana de auditoría no encuentro al menos <span class=\"text-zinc-200 font-medium\">3 fallos críticos</span> que hundirían tus reseñas en Steam, <span class=\"text-emerald-400 font-medium\">la consultoría es completamente gratis.</span>\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Desglose Semanal (Captura de Leads) -->\n    <section id=\"desglose\" class=\"py-32 border-y border-white/[0.02] bg-zinc-950/30 relative z-10\">\n        <div class=\"max-w-3xl mx-auto px-6 text-center reveal\">\n            <i data-lucide=\"mail\" class=\"w-8 h-8 text-zinc-600 mx-auto mb-8\"></i>\n            <h2 class=\"text-3xl md:text-4xl font-medium text-zinc-100 tracking-tight mb-4\">Desglose Semanal</h2>\n            <p class=\"text-zinc-400 font-light leading-relaxed mb-10\">\n                Auditorías reales, errores caros de otros estudios y tácticas de retención directo en tu bandeja. Sin spam, solo ingeniería de calidad.\n            </p>\n            \n            <form class=\"flex flex-col sm:flex-row gap-3 max-w-lg mx-auto\" onsubmit=\"event.preventDefault();\">\n                <input type=\"email\" placeholder=\"tu@estudio.com\" required\n                    class=\"flex-grow px-6 py-4 rounded-xl bg-[#050505] border border-zinc-800 text-zinc-100 text-sm placeholder-zinc-600 focus:outline-none focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 transition-all\">\n                <button type=\"submit\" \n                    class=\"px-8 py-4 rounded-xl bg-zinc-800 text-zinc-200 hover:bg-zinc-700 hover:text-white active:scale-[0.98] transition-all text-xs font-semibold tracking-widest uppercase\">\n                    Suscribirme\n                </button>\n            </form>\n        </div>\n    </section>\n\n    <!-- Final CTA (El Filtro) -->\n    <section id=\"cta\" class=\"py-32 md:py-48 relative z-10\">\n        <div class=\"max-w-4xl mx-auto px-6 text-center reveal\">\n            <span class=\"inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/[0.03] border border-white/[0.05] text-xs font-semibold uppercase tracking-widest text-zinc-400 mb-8\">\n                <span class=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n                Quedan 2 cupos este mes\n            </span>\n            \n            <h2 class=\"text-5xl md:text-7xl font-medium text-zinc-100 tracking-tighter mb-8\">\n                Tu lanzamiento está en juego.\n            </h2>\n            \n            <p class=\"text-xl text-zinc-400 font-light leading-relaxed mb-12 max-w-2xl mx-auto\">\n                Solo trabajo con un puñado de estudios al mes para garantizar atención de nivel AAA. Si estás a menos de 3 meses de lanzar, hablemos de Dev a Dev.\n            </p>\n\n            <a href=\"https://calendly.com/\" target=\"_blank\" rel=\"noopener noreferrer\" \n                class=\"inline-block w-full sm:w-auto px-12 py-6 rounded-2xl bg-zinc-100 text-[#050505] hover:bg-white active:scale-[0.98] transition-all text-sm md:text-base font-bold tracking-widest uppercase shadow-premium\">\n                Agendar en Calendly\n            </a>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"py-12 border-t border-white/[0.05] bg-[#050505] relative z-10\">\n        <div class=\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6\">\n            \n            <div class=\"flex flex-col items-center md:items-start gap-2\">\n                <div class=\"flex items-center gap-2\">\n                    <i data-lucide=\"shield-check\" class=\"w-4 h-4 text-zinc-600\"></i>\n                    <span class=\"font-medium text-sm tracking-widest uppercase text-zinc-500\">LaunchGuard</span>\n                </div>\n                <p class=\"text-[10px] text-zinc-600 uppercase tracking-widest\">\n                    © 2026 Ezequiel Canello. All rights reserved.\n                </p>\n            </div>\n\n            <div class=\"flex items-center gap-6\">\n                <a href=\"#\" class=\"text-zinc-600 hover:text-zinc-300 transition-colors\">\n                    <i data-lucide=\"linkedin\" class=\"w-5 h-5\"></i>\n                </a>\n                <a href=\"#\" class=\"text-zinc-600 hover:text-zinc-300 transition-colors\">\n                    <i data-lucide=\"instagram\" class=\"w-5 h-5\"></i>\n                </a>\n            </div>\n\n            <div class=\"flex items-center gap-2 opacity-50 hover:opacity-100 transition-opacity\">\n                <span class=\"text-[10px] uppercase tracking-widest font-semibold text-zinc-500\">Powered by</span>\n                <span class=\"font-bold text-xs tracking-widest text-zinc-300\">DELTA</span>\n            </div>\n            \n        </div>\n    </footer>\n\n    <!-- Scripts de Terceros vía CDN -->\n    <!-- Lenis para Smooth Scrolling -->\n    <script src=\"https://unpkg.com/lenis@1.1.13/dist/lenis.min.js\"></script>\n    <!-- Vanilla Tilt para efecto 3D en tarjetas -->\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js\"></script>\n\n    <script>\n        // 1. Inicialización de Lucide Icons\n        lucide.createIcons();\n\n        // 2. Inicialización de Lenis Smooth Scroll\n        const lenis = new Lenis({\n            duration: 1.5, // Scroll más largo y mantecoso\n            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // Curva Apple-like\n            smoothWheel: true,\n            smoothTouch: false\n        });\n\n        function raf(time) {\n            lenis.raf(time);\n            requestAnimationFrame(raf);\n        }\n        requestAnimationFrame(raf);\n\n        // 3. Inicialización del Intersection Observer para Scroll Reveals\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            const revealElements = document.querySelectorAll(\".reveal\");\n            \n            const observerOptions = {\n                root: null,\n                rootMargin: \"0px 0px -10% 0px\", // Revela un poco antes de entrar completamente\n                threshold: 0.05\n            };\n\n            const observer = new IntersectionObserver((entries, observer) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        entry.target.classList.add(\"active\");\n                        // Desvincular para optimizar rendimiento una vez revelado\n                        observer.unobserve(entry.target);\n                    }\n                });\n            }, observerOptions);\n\n            revealElements.forEach(el => observer.observe(el));\n        });\n    </script>\n</body>\n</html>"
